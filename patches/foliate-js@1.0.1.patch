@@ -31,6 +31,31 @@ const getViewport = (doc, viewport) => {
     return { width: 1000, height: 2000 }
 }
 
+const isMobileReaderEnv = () => !!globalThis.siyuan?.mobile
+    || /Android|iPhone|iPad|iPod|Mobile/i.test(globalThis.navigator?.userAgent ?? '')
+
+const blobToDataURL = blob => new Promise((resolve, reject) => {
+    const reader = new FileReader()
+    reader.onload = () => resolve(reader.result)
+    reader.onerror = () => reject(reader.error ?? new Error('Failed to read blob as data URL'))
+    reader.readAsDataURL(blob)
+})
+
+const assignFrameSource = async (iframe, src) => {
+    if (!src?.startsWith?.('blob:') || !isMobileReaderEnv()) {
+        iframe.src = src
+        return
+    }
+    const res = await fetch(src)
+    const blob = await res.blob()
+    const type = blob.type || ''
+    if (/^(text\/|application\/xhtml\+xml|application\/xml|image\/svg\+xml)/i.test(type)) {
+        iframe.srcdoc = await blob.text()
+        return
+    }
+    iframe.src = await blobToDataURL(blob)
+}
